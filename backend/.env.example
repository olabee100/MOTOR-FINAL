# Copy this file to .env and fill in real values before deploying.

# Port the server listens on (most hosts set this for you automatically)
PORT=4000

# Long random string used to sign login tokens. Change this to something unique.
JWT_SECRET=change-this-to-a-long-random-string

# How many hours a login stays valid before the person must log in again
JWT_EXPIRES_HOURS=12

# --- First admin account, created automatically the first time the server starts ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Maintenance Admin

# --- SMS alerts (optional) ---
# Leave SMS_PROVIDER=none to run with no SMS cost. High-urgency breakdowns will
# just be written to the server log instead of sent as a text message.
# Set to "termii" and fill in the keys below once you have a paid Termii account.
SMS_PROVIDER=none
TERMII_API_KEY=
TERMII_SENDER_ID=MotorTrack
# Comma-separated list of phone numbers (with country code, e.g. 2348012345678)
# to notify on every HIGH urgency breakdown.
ALERT_PHONE_NUMBERS=
